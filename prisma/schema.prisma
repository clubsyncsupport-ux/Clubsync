// ClubSync database schema.
//
// Runs on local SQLite today. To migrate to PostgreSQL later:
//   1. Change `provider = "sqlite"` to `provider = "postgresql"` below.
//   2. Point DATABASE_URL (in .env) at a Postgres connection string.
//   3. Run `npx prisma migrate dev`.
// No application code needs to change — everything goes through
// src/lib/db.ts, and Prisma generates the same client API for both.
//
// String fields commented "enum-like" hold one of a fixed set of values
// (see src/lib/constants.ts for the TS union types). Plain strings are used
// instead of Prisma `enum` because the SQLite connector doesn't support them;
// switching to Postgres later would let us upgrade these to real enums if desired.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------- Accounts ----------

model User {
  id                String   @id @default(cuid())
  email             String   @unique
  passwordHash      String? // null if account was created via a future external auth provider
  // Google's stable per-account "sub" claim, set the first time this account
  // signs in with Google (whether that's a brand-new account or linking an
  // existing password account that shares the same email). Null otherwise.
  googleId          String?  @unique
  // Set only if this person has separately connected Google Calendar (a
  // different, extra permission from signing in with Google — see
  // /api/auth/google-calendar/*). One-directional: read-only, used to show
  // their personal events alongside club ones. ClubSync never writes to it.
  googleCalendarRefreshToken String?
  googleCalendarConnectedAt  DateTime?
  // A refresh-token exchange gets a new short-lived access token (Google
  // typically issues one valid for about an hour) — caching it here means a
  // calendar page load reuses it until it's actually close to expiring,
  // instead of exchanging the refresh token again on every single view.
  googleCalendarAccessToken           String?
  googleCalendarAccessTokenExpiresAt  DateTime?
  firstName         String
  lastName          String
  avatarUrl         String?
  bio               String?

  // platformRole: "STUDENT" | "SCHOOL_ADMIN" | "PRINCIPAL" | "VICE_PRINCIPAL" |
  // "PLATFORM_ADMIN" — separate from club-level roles below. SCHOOL_ADMIN,
  // PRINCIPAL, and VICE_PRINCIPAL all get identical "school admin"-shaped
  // access to exactly one school, pointed to by schoolAdminOfId (distinct
  // from schoolId, which is this person's own student/staff school — none of
  // these three need a profile there at all); they're separate values only so
  // approval routing can notify/label Principal/Vice Principal specifically
  // (see isSchoolAdminTier / canActionApprovals in src/lib/constants.ts).
  platformRole      String   @default("STUDENT")
  // accountStatus: "ACTIVE" | "SUSPENDED" | "MERGED" | "DELETED" — DELETED is
  // set by a self-service account deletion that had verified service-hour
  // records to preserve (see deleteMyAccountAction): passwordHash, googleId,
  // and every session are cleared so the row can never be signed into again,
  // but the row itself and its VERIFIED ServiceHourRecord rows survive as
  // the school's copy of that record. A deletion with nothing to preserve
  // still does a real db.user.delete() instead — DELETED only exists for
  // the case that actually needs it.
  accountStatus     String   @default("ACTIVE")
  // Login rate-limiting: counts consecutive failed password attempts, reset
  // to 0 on a successful login. Crossing each tier in LOCKOUT_TIERS (see
  // local-provider.ts) sets lockedUntil to an escalating duration; further
  // attempts are refused until that time passes, regardless of whether the
  // password given is actually correct. Reaching the final tier also sets
  // mustResetPassword, which blocks sign-in outright (even after the lock
  // expires) until the account owner completes the "forgot password" flow —
  // proof of email access rather than another guessed password.
  failedLoginAttempts Int      @default(0)
  lockedUntil         DateTime?
  mustResetPassword   Boolean  @default(false)
  // Set when this account has been merged into another (see mergeUserAccountsAction) —
  // its club memberships, service-hour records, and event registrations have been
  // moved to mergedIntoId, and this account can no longer log in. Plain id reference,
  // no relation, mirroring Club.mergedIntoId.
  mergedIntoId      String?
  // accountKind: "STUDENT" | "STAFF" — STAFF is for a sponsor teacher / club-only
  // account that signed up directly as a Club Director. It has no grade and no
  // "Student" profile — its entire experience is the director dashboard(s) it owns.
  // A student who later creates a club via "+ Create Club" stays accountKind STUDENT
  // and simply gains an extra director profile alongside their student one.
  accountKind       String   @default("STUDENT")
  // staffApprovalStatus: "PENDING" | "APPROVED" | "REJECTED" — only ever
  // set for accountKind STAFF. Set to PENDING the moment someone completes
  // Teacher onboarding; until a Platform Admin approves it, createClubAction
  // refuses to let them create a club. Without this, a student could pick
  // "Teacher" at signup to skip the supervisor-vouching a student-created
  // club otherwise requires and create a club with no oversight at all.
  staffApprovalStatus String?

  grade             String?
  schoolId          String?
  school            School?  @relation(fields: [schoolId], references: [id])

  // Set only when platformRole is SCHOOL_ADMIN — the one school this account
  // administers. Assigned/changed exclusively by a Platform Admin.
  schoolAdminOfId   String?
  schoolAdminOf     School?  @relation("SchoolAdminOf", fields: [schoolAdminOfId], references: [id])

  serviceHourGoal   Int      @default(50)

  // settings
  theme             String   @default("system") // "light" | "dark" | "system"
  calendarView      String   @default("month")  // "month" | "week" | "day" | "agenda"
  weekStartsOn      String   @default("sunday")
  timeFormat        String   @default("12h")     // "12h" | "24h"
  // Comma-separated minutes-before values, e.g. "60,1440" = 1 hour and 1 day
  // before. See REMINDER_OFFSETS in src/lib/constants.ts for the allowed set.
  reminderOffsets   String   @default("1440")
  // Last time generateEventReminders actually ran its (more expensive)
  // registrations check for this person, so it can skip re-running on every
  // single page nav — see src/lib/reminders.ts.
  remindersCheckedAt DateTime?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  sessions            Session[]
  memberships         ClubMembership[]
  memberGroupMemberships MemberGroupMembership[]
  createdClubs        Club[]              @relation("ClubCreatedBy")
  pendingSupervisorFor Club[]             @relation("ClubPendingSupervisor")
  eventRegistrations  EventRegistration[]
  eventInvites        EventInvite[]
  serviceHourRecords  ServiceHourRecord[]  @relation("ServiceHourOwner")
  approvedServiceHours ServiceHourRecord[] @relation("ServiceHourApprover")
  notifications       Notification[]
  achievements        UserAchievement[]
  createdAnnouncements Announcement[]
  auditLogs           AuditLog[]           @relation("AuditActor")
  createdEvents       Event[]              @relation("EventCreatedBy")
  personalEvents      PersonalEvent[]
  personalEventCategories PersonalEventCategory[]

  sponsorApprovedEvents Event[] @relation("EventSponsorApprovedBy")
  adminApprovedEvents   Event[] @relation("EventAdminApprovedBy")
  submittedClubRegistrations       ClubRegistration[] @relation("ClubRegistrationSubmittedBy")
  sponsorApprovedClubRegistrations ClubRegistration[] @relation("ClubRegistrationSponsorApprovedBy")
  adminApprovedClubRegistrations   ClubRegistration[] @relation("ClubRegistrationAdminApprovedBy")

  createdChannels     Channel[]            @relation("ChannelCreatedBy")
  channelMemberships  ChannelMembership[]
  sentChatMessages    ChatMessage[]        @relation("ChatMessageSender")
  chatMessageReactions ChatMessageReaction[]

  createdPositions     ClubPosition[]         @relation("ClubPositionCreatedBy")
  positionApplications PositionApplication[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  userAgent String?
  createdAt DateTime @default(now())
  expiresAt DateTime
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime
}

model School {
  id        String   @id @default(cuid())
  name      String   @unique
  city      String?
  region    String?
  country   String?
  createdAt DateTime @default(now())

  // Ordered CSV of this school's grade levels, low → high (e.g. a school that
  // skips Grade 8 would use "Grade 9,Grade 10,Grade 11,Grade 12"). A subset +
  // reorder of the standard GRADES constant — see src/lib/grades.ts.
  gradeLevels String @default("Grade 8,Grade 9,Grade 10,Grade 11,Grade 12")

  users        User[]
  clubs        Club[]
  schoolAdmins User[] @relation("SchoolAdminOf")
  calendarEvents SchoolCalendarEvent[]
}

// School-published events (Pro-D days, Collaboration Days, parent-teacher
// conferences, assemblies, cultural observances, etc.) imported wholesale
// from the school's own public calendar feed — see
// prisma/import-school-calendar.ts. Shown on the student calendar view
// alongside club events, distinctly styled; also what the bell-schedule
// widget (src/lib/bell-schedule.ts) reads to know which day-type applies on
// a given date (Collaboration Day / Pro-D / a rotation code like "ABCD").
model SchoolCalendarEvent {
  id       String   @id @default(cuid())
  schoolId String
  school   School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  date     DateTime
  endDate  DateTime?
  title    String
  // category: "SCHEDULE" (a day-type/rotation label like "ABCD") | "COLLABORATION_DAY" |
  // "PRO_D" | "SCHOOL_CLOSED" | "PARENT_TEACHER" | "OBSERVANCE" | "OTHER"
  category String

  @@index([schoolId, date])
}

// ---------- Clubs ----------

model Club {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  description      String
  missionStatement String?
  category         String   // comma-joined multi-value CSV, e.g. "Academic,STEM" — from "Academic" | "Athletics" | "STEM" | "Arts" | "Volunteer" | ...
  color            String   // hex color, unique-ish per school (enforced in app logic)
  logoUrl          String?
  bannerUrl        String?

  schoolId         String
  school           School   @relation(fields: [schoolId], references: [id])

  meetingSchedule  String?
  meetingLocation  String?
  contactEmail     String?
  instagramUrl     String?
  websiteUrl       String?

  // Comma-separated grade values (same shape as Event.allowedGrades) —
  // null/empty means open to every grade. Only gates joining; the club stays
  // visible to everyone in Discover regardless.
  allowedGrades    String?

  requiresApproval Boolean  @default(false)

  createdById      String
  createdBy        User     @relation("ClubCreatedBy", fields: [createdById], references: [id])

  // moderation / lifecycle
  status           String   @default("ACTIVE") // "ACTIVE" | "ARCHIVED" | "MERGED"
  mergedIntoId     String?

  // approvalStatus: "APPROVED" | "PENDING_SUPERVISOR" — a club a STUDENT
  // self-creates starts PENDING_SUPERVISOR and is invisible to everyone
  // except its creator, the picked pendingSupervisorId teacher, and admins,
  // until that teacher approves it (see supervisor-request actions). A club
  // a TEACHER creates themselves, or one created via the admin panel,
  // defaults straight to APPROVED — no review needed, matching every
  // existing club's default.
  approvalStatus     String  @default("APPROVED")
  pendingSupervisorId String?
  pendingSupervisor   User?  @relation("ClubPendingSupervisor", fields: [pendingSupervisorId], references: [id])

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  memberships   ClubMembership[]
  events        Event[]
  announcements Announcement[]
  serviceHours  ServiceHourRecord[]
  memberGroups  MemberGroup[]
  contacts      ClubContact[]
  registrations ClubRegistration[]
  channels      Channel[]
  positions     ClubPosition[]
}

// ---------- Positions (Apply, distinct from Register) ----------
// A club-defined role (e.g. "Vice President") with its own application
// questions — separate from EventRegistration, which is "I'm coming to this
// event," not "consider me for this role." Free-text answers (word-limited)
// plus, if the position allows it, one uploaded file.

model ClubPosition {
  id          String   @id @default(cuid())
  clubId      String
  club        Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  title       String
  description String?
  allowFileUpload Boolean @default(false)
  // status: "OPEN" | "CLOSED" — closing a position stops new applications
  // without deleting the ones already submitted.
  status      String   @default("OPEN")
  createdById String
  createdBy   User     @relation("ClubPositionCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  questions    PositionQuestion[]
  applications PositionApplication[]

  @@unique([clubId, title])
}

model PositionQuestion {
  id         String       @id @default(cuid())
  positionId String
  position   ClubPosition @relation(fields: [positionId], references: [id], onDelete: Cascade)
  prompt     String
  wordLimit  Int          @default(200)
  order      Int          @default(0)

  answers PositionAnswer[]
}

model PositionApplication {
  id          String       @id @default(cuid())
  positionId  String
  position    ClubPosition @relation(fields: [positionId], references: [id], onDelete: Cascade)
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileUrl     String?
  // status: "PENDING" | "ACCEPTED" | "REJECTED"
  status      String       @default("PENDING")
  submittedAt DateTime     @default(now())
  reviewedAt  DateTime?

  answers PositionAnswer[]

  @@unique([positionId, userId])
}

model PositionAnswer {
  id            String               @id @default(cuid())
  applicationId String
  application   PositionApplication  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  questionId    String
  question      PositionQuestion     @relation(fields: [questionId], references: [id], onDelete: Cascade)
  body          String

  @@unique([applicationId, questionId])
}

// A saved student-contact phone number for a club, used on the event
// proposal form. Full list (including phone) is visible only to the club's
// Director/Sponsor Teacher; anyone else filling out a proposal sees contact
// names only and can reveal one selected contact's number on demand — see
// src/app/actions/club-contacts.ts.
model ClubContact {
  id        String   @id @default(cuid())
  clubId    String
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  name      String
  phone     String
  createdAt DateTime @default(now())

  events Event[]
}

// One row per club per school year — the digitized, resubmitted-annually
// club registration form (sponsor confirmation, meeting details, fundraising
// guidelines). Carries the same 2-stage Sponsor Teacher → Administrator
// approval chain as Event proposals (see src/lib/approvals.ts).
model ClubRegistration {
  id     String @id @default(cuid())
  clubId String
  club   Club   @relation(fields: [clubId], references: [id], onDelete: Cascade)
  // e.g. "2026-2027" — see schoolYearFor() in src/lib/school-year.ts.
  schoolYear String

  description           String
  meetingSchedule        String?
  meetingLocation        String?
  fundraisingGuidelines  String?

  // status: "PENDING_SPONSOR" | "PENDING_ADMIN" | "APPROVED" | "REJECTED"
  status              String    @default("PENDING_SPONSOR")
  submittedById       String
  submittedBy         User      @relation("ClubRegistrationSubmittedBy", fields: [submittedById], references: [id])
  sponsorApprovedById String?
  sponsorApprovedBy   User?     @relation("ClubRegistrationSponsorApprovedBy", fields: [sponsorApprovedById], references: [id])
  sponsorApprovedAt   DateTime?
  adminApprovedById   String?
  adminApprovedBy     User?     @relation("ClubRegistrationAdminApprovedBy", fields: [adminApprovedById], references: [id])
  adminApprovedAt     DateTime?
  rejectionReason     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clubId, schoolYear])
}

// A director-defined tag like "Executive Team" — lets a director bulk-select
// a known set of members when creating an event instead of checking each
// name individually every time. A member can belong to any number of groups
// at once (e.g. both "Executive Team" and "Fundraising Committee").
model MemberGroup {
  id        String   @id @default(cuid())
  clubId    String
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  name      String
  color     String
  createdAt DateTime @default(now())

  members MemberGroupMembership[]

  @@unique([clubId, name])
}

model MemberGroupMembership {
  id      String      @id @default(cuid())
  groupId String
  group   MemberGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId  String
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
}

model ClubMembership {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clubId    String
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)

  // role: "MEMBER" | "OFFICER" | "SUPER_ADMIN" | "DIRECTOR" — OFFICER displays
  // as "Admin" in the UI, SUPER_ADMIN as "Super Admin" (a trusted
  // student-leader tier strictly above Officer, added for club chat — see
  // src/lib/chat.ts), DIRECTOR as "Director"/"Teacher"/"Sponsor Teacher"
  // depending on context.
  role      String   @default("MEMBER")
  // status: "ACTIVE" | "PENDING"
  status    String   @default("ACTIVE")

  joinedAt  DateTime @default(now())

  @@unique([userId, clubId])
}

// ---------- Club Chat ----------
// A single Channel model covers both topic channels and DMs — a 1:1 or a
// Super-Admin group chat is just a Channel with visibility DIRECT and a
// fixed participant list, not a separate table. This is what structurally
// guarantees every conversation has a clubId (and therefore a Sponsor
// Teacher who can see it) — there is no way to build a platform-wide DM by
// construction. See src/lib/chat.ts for the permission rules.

model Channel {
  id     String @id @default(cuid())
  clubId String
  club   Club   @relation(fields: [clubId], references: [id], onDelete: Cascade)

  // Null for DIRECT channels — their display name is derived from the
  // participant list client-side rather than stored.
  name String?
  // visibility: "OPEN" (visible to all members, joins instantly) |
  // "REQUEST" (visible to all members, join needs Admin+ approval) |
  // "INVITE" (invisible to non-members, only Admin+ can add someone) |
  // "DIRECT" (a 1:1 or fixed-participant group chat)
  visibility String
  // Orthogonal to visibility — when true, only members with
  // ChannelMembership.canPost may send; everyone else can read (and react)
  // but not post.
  restrictedPosting Boolean @default(false)

  createdById String
  createdBy   User   @relation("ChannelCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  memberships ChannelMembership[]
  messages    ChatMessage[]

  @@unique([clubId, name])
}

model ChannelMembership {
  id        String  @id @default(cuid())
  channelId String
  channel   Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  // status: "ACTIVE" | "PENDING" — mirrors ClubMembership's join-request shape.
  status String @default("ACTIVE")
  // Meaningful only when the channel is restrictedPosting; ignored otherwise.
  canPost Boolean @default(true)

  joinedAt DateTime @default(now())

  @@unique([channelId, userId])
}

// Deliberately has no delete/edit-in-place/expiry field — permanent logging
// is enforced at the schema level, not just by convention.
model ChatMessage {
  id            String   @id @default(cuid())
  channelId     String
  channel       Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  senderId      String
  sender        User     @relation("ChatMessageSender", fields: [senderId], references: [id])
  // body is always the real, original text as typed — the permanent record.
  // filteredBody is set only when the profanity filter (src/lib/profanity-filter.ts)
  // actually changed something; regular participants are shown
  // filteredBody ?? body, but the club's Sponsor Teacher and OVERSIGHT
  // viewers always see the real body — a filtered message shouldn't hide a
  // real behavior problem from the one adult responsible for the club.
  body          String
  filteredBody  String?
  attachmentUrl String?
  createdAt     DateTime @default(now())

  reactions ChatMessageReaction[]

  @@index([channelId, createdAt])
}

model ChatMessageReaction {
  id        String      @id @default(cuid())
  messageId String
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String

  @@unique([messageId, userId, emoji])
}

// ---------- Events ----------

model Event {
  id                    String   @id @default(cuid())
  clubId                String
  club                  Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)

  title                 String
  description           String
  category              String   // "Meeting" | "Volunteer" | "Competition" | "Workshop" | "Social" | "Executive Meeting" | "Community Event" | "Sports Training"
  bannerUrl             String?

  // approvalStatus: "PENDING_SPONSOR" | "PENDING_ADMIN" | "APPROVED" | "REJECTED".
  // Events in an auto-approved category ("Meeting", "Executive Meeting" — see
  // src/lib/approvals.ts) stay APPROVED from creation, exactly as before this
  // field existed. Every other category enters the 2-stage Sponsor Teacher →
  // Administrator chain; stage 1 auto-clears if the submitter is already the
  // club's own Director. A pending/rejected event is hidden from students
  // everywhere except to school staff (who can preview it), mirroring how
  // Club.approvalStatus already gates visibility.
  approvalStatus      String    @default("APPROVED")
  sponsorApprovedById String?
  sponsorApprovedBy   User?     @relation("EventSponsorApprovedBy", fields: [sponsorApprovedById], references: [id])
  sponsorApprovedAt   DateTime?
  adminApprovedById   String?
  adminApprovedBy     User?     @relation("EventAdminApprovedBy", fields: [adminApprovedById], references: [id])
  adminApprovedAt     DateTime?
  rejectionReason     String?

  // "Resources / logistics" — admin-only, never rendered on the public event page.
  internalNotes  String?
  purpose        String?
  audience       String?
  promotionPlan  String?
  // Independent of category (a bake sale can be a Social event too) — see
  // the backfill script that migrated the old "Fundraiser" category value.
  isFundraiser       Boolean  @default(false)
  fundraisingDetails String?
  contactId          String?
  contact            ClubContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  startAt               DateTime
  endAt                 DateTime
  timezone              String   @default("America/Vancouver")

  building              String?
  room                  String?
  address               String?
  mapLink               String?

  // visibility: "PUBLIC" | "PRIVATE"
  visibility            String   @default("PUBLIC")
  // Comma-separated grade values (e.g. "Grade 9,Grade 10") restricting who can
  // register. Null/empty means open to every grade. Doesn't affect who can see
  // the event, only who can register for it.
  allowedGrades         String?

  maxParticipants       Int?
  registrationDeadline  DateTime?
  waitlistEnabled       Boolean  @default(false)
  // Caps how many people can sit on the waitlist itself, independent of
  // maxParticipants (which caps REGISTERED, not WAITLISTED). Null means
  // unlimited — only meaningful when waitlistEnabled is true.
  waitlistCapacity      Int?

  awardsServiceHours    Boolean  @default(false)
  defaultServiceHours   Float    @default(0)
  serviceTaskDescription String?

  // Independent of awardsServiceHours — a meeting can track who showed up
  // without handing out hours, or award hours without a formal roster.
  attendanceEnabled     Boolean  @default(false)
  // Off by default — the planning checklist is director-only until a
  // director explicitly opts to let members see it too (e.g. so students
  // can track what's left to prepare for their own event).
  checklistVisibleToStudents Boolean @default(false)

  // status: "SCHEDULED" | "COMPLETED" | "FINALIZED" | "CANCELLED"
  status                String   @default("SCHEDULED")
  eventImpact           String?

  // recurrence: "NONE" | "DAILY" | "WEEKLY" | "MONTHLY"
  recurrence            String   @default("NONE")
  recurrenceParentId    String?
  recurrenceUntil       DateTime?

  createdById           String
  createdBy             User     @relation("EventCreatedBy", fields: [createdById], references: [id])

  createdAt             DateTime @default(now())
  updatedAt              DateTime @updatedAt

  registrations   EventRegistration[]
  invites         EventInvite[]
  attachments     EventAttachment[]
  checklistItems  EventChecklistItem[]
  serviceHours    ServiceHourRecord[]
  roles           EventRole[]
}

// Optional signup roles for an event (e.g. "Setup Crew", "Referee") — when an
// event has any roles defined, joining requires picking one (see
// EventRegistration.roleId), so a director can see at a glance which roles
// are filled instead of just a single headcount.
model EventRole {
  id       String @id @default(cuid())
  eventId  String
  event    Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name     String
  capacity Int
  order    Int    @default(0)
  // Comma-separated grade levels, e.g. "Grade 10,Grade 11,Grade 12" — null
  // means this role has no restriction of its own beyond whatever the
  // event's own allowedGrades already filters (e.g. "Scorekeeper" can be
  // Grade 10+ even on an event otherwise open to every grade).
  allowedGrades String?
  // Caps how many people can sit on the waitlist for this specific role,
  // independent of the role's own capacity (REGISTERED) or the event's
  // overall waitlistCapacity. Null means unlimited.
  waitlistCapacity Int?

  registrations EventRegistration[]
}

model EventInvite {
  id      String @id @default(cuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}

model EventRegistration {
  id           String   @id @default(cuid())
  eventId      String
  event        Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // status: "REGISTERED" | "WAITLISTED" | "CANCELLED" | "ATTENDED" | "NO_SHOW"
  status       String   @default("REGISTERED")
  registeredAt DateTime @default(now())

  // Which signup role this person picked, if the event has any defined.
  // Null when the event has no roles at all.
  roleId String?
  role   EventRole? @relation(fields: [roleId], references: [id], onDelete: SetNull)

  // Comma-separated minutes-before values overriding the user's account-wide
  // reminderOffsets default for just this event. Null = use the default.
  reminderOffsets String?

  // Director's free-text note from the Attendance page (e.g. "left early").
  attendanceNote String?

  @@unique([eventId, userId])
}

model EventAttachment {
  id         String   @id @default(cuid())
  eventId    String
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  filename   String
  url        String
  mimeType   String
  size       Int
  uploadedAt DateTime @default(now())
}

model EventChecklistItem {
  id          String   @id @default(cuid())
  eventId     String
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  task        String
  description String?
  dueDate     DateTime?
  completed   Boolean  @default(false)
  order       Int      @default(0)
}

model Announcement {
  id          String   @id @default(cuid())
  clubId      String
  club        Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  title       String
  body        String
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
}

// ---------- Service Hours & Achievements ----------

model ServiceHourRecord {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation("ServiceHourOwner", fields: [userId], references: [id], onDelete: Cascade)
  // clubId is null for self-reported hours from outside ClubSync (see selfReported below).
  clubId           String?
  club             Club?    @relation(fields: [clubId], references: [id], onDelete: Cascade)
  eventId          String?
  event            Event?   @relation(fields: [eventId], references: [id])

  hours            Float
  taskDescription  String?
  eventImpact      String?
  reflection       String?

  // Only set for self-reported hours (organization/supervisor instead of a ClubSync club).
  organizationName String?
  supervisorName   String?
  performedAt      DateTime?
  // True for hours a student logs themselves for volunteering outside any ClubSync
  // club/event. These start at status "PENDING" (never auto-VERIFIED) to preserve
  // the "verified means a director confirmed it" trust principle — students never
  // mark their own hours VERIFIED.
  selfReported     Boolean  @default(false)

  // status: "VERIFIED" | "PENDING" | "REJECTED"
  status           String   @default("VERIFIED")

  approvedById     String?
  approvedBy       User?    @relation("ServiceHourApprover", fields: [approvedById], references: [id])
  approvedAt       DateTime?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Achievement {
  id          String @id @default(cuid())
  key         String @unique
  title       String
  description String
  icon        String

  users UserAchievement[]
}

model UserAchievement {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  unlockedAt    DateTime    @default(now())

  @@unique([userId, achievementId])
}

// ---------- Personal Calendar ----------

// A student's own named color legend for personal events (e.g. "Volunteering"
// = purple, "Personal Life" = gray) — lets them build their own categorization
// system. Colors are unique per-user so two categories never look the same.
model PersonalEventCategory {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  color     String
  createdAt DateTime @default(now())

  events PersonalEvent[]

  @@unique([userId, color])
}

// A student's own calendar entries — not tied to any club, visible only to
// them, shown alongside (but separately styled from) club events.
model PersonalEvent {
  id          String                 @id @default(cuid())
  userId      String
  user        User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  startAt     DateTime
  endAt       DateTime
  location    String?
  categoryId  String?
  category    PersonalEventCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  // recurrence: "NONE" | "DAILY" | "WEEKLY" | "MONTHLY" — mirrors Event's
  // recurrence fields. Each occurrence is its own row; recurrenceParentId
  // links repeats back to the first one so they can be deleted as a group.
  recurrence         String    @default("NONE")
  recurrenceParentId String?
  recurrenceUntil    DateTime?

  createdAt   DateTime               @default(now())
}

// ---------- Notifications & Audit ----------

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // "EVENT_REMINDER" | "ANNOUNCEMENT" | "REGISTRATION" | "SERVICE_HOURS" | "ACHIEVEMENT" | "PLATFORM" | "CHAT_MESSAGE" | "CLUB_SUPERVISOR_REQUEST" | "EVENT_PROPOSAL" | "CLUB_REGISTRATION"
  title     String
  body      String
  linkUrl   String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model AuditLog {
  id            String   @id @default(cuid())
  actorUserId   String
  actor         User     @relation("AuditActor", fields: [actorUserId], references: [id])
  action        String
  targetType    String
  targetId      String
  previousValue String?
  newValue      String?
  reason        String?
  createdAt     DateTime @default(now())
}
